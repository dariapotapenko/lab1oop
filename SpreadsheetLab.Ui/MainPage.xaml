<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpreadsheetLab.Ui.MainPage"
             Title="Електронні таблиці">

    <Grid Padding="10" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="0">
                <Label Text="Електронні таблиці" FontSize="24" FontAttributes="Bold" />
                <Label Text="Лабораторна робота №1" FontSize="13" TextColor="Gray" />
            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <Label x:Name="ModeLabel" Text="Режим: ВИРАЗИ" VerticalTextAlignment="Center" />
                <Switch x:Name="ModeSwitch" Toggled="ModeSwitch_Toggled" />
            </HorizontalStackLayout>
        </Grid>

        <Border Grid.Row="1" Stroke="LightGray" Padding="8">
            <ScrollView Orientation="Horizontal">
                <HorizontalStackLayout Spacing="6">
                    <Button Text="Обчислити" Clicked="CalculateButton_Clicked" />
                    <Button Text="Нова таблиця" Clicked="NewButton_Clicked" />
                    <Button Text="Зберегти" Clicked="SaveButton_Clicked" />
                    <Button Text="Відкрити" Clicked="OpenButton_Clicked" />
                    <Button Text="Довідка" Clicked="HelpButton_Clicked" />
                    <Button Text="Про програму" Clicked="AboutButton_Clicked" />
                    <Button Text="Вийти" Clicked="ExitButton_Clicked" />
                </HorizontalStackLayout>
            </ScrollView>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="6">
            <Grid ColumnDefinitions="Auto,70,*,Auto" ColumnSpacing="6">
                <Label Text="Активна клітинка" VerticalTextAlignment="Center" />
                <Border Grid.Column="1" Stroke="LightGray" Padding="6,3">
                    <Label x:Name="ActiveCellLabel" Text="A1" HorizontalTextAlignment="Center" />
                </Border>
                <Entry x:Name="FormulaEntry"
                       Grid.Column="2"
                       Placeholder="Введіть число, посилання або вираз"
                       Completed="FormulaEntry_Completed" />
                <Button Grid.Column="3" Text="Ввести" Clicked="ApplyFormulaButton_Clicked" />
            </Grid>

            <ScrollView Grid.Row="1" Orientation="Horizontal">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="Структура" VerticalTextAlignment="Center" Margin="0,0,4,0" />
                    <Button Text="− Рядок" Clicked="RemoveRowButton_Clicked" />
                    <Button Text="+ Рядок" Clicked="AddRowButton_Clicked" />
                    <Button Text="− Стовпчик" Clicked="RemoveColumnButton_Clicked" />
                    <Button Text="+ Стовпчик" Clicked="AddColumnButton_Clicked" />
                </HorizontalStackLayout>
            </ScrollView>
        </Grid>

        <Border Grid.Row="3" Stroke="LightGray">
            <ScrollView Orientation="Both">
                <Grid x:Name="SpreadsheetGrid" />
            </ScrollView>
        </Border>

        <Label x:Name="StatusLabel" Grid.Row="4" Text="Готово" FontSize="12" TextColor="Gray" />
    </Grid>
</ContentPage>
